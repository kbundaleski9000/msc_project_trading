        "      p = p_prev + λ y\n",
        "\n",
        "    Insider payoff: x (v - p)\n",
        "    MM payoff:      -(p - v)^2\n",
        "    \"\"\"\n",
        "    x = beta * (v - p_prev)\n",
        "    y = x + u\n",
        "    p = p_prev + lam * y\n",
        "\n",
        "    insider_profit = x * (v - p)\n",
        "    mm_profit      = -(p - v) ** 2\n",
        "    return insider_profit, mm_profit, p\n",
        "\n",
        "# Globals used so calculate_utility sees the same (v, p_{t-1}, u_t)\n",
        "CURRENT_V      = None\n",
        "CURRENT_P_PREV = None\n",
        "CURRENT_U      = None\n",
        "\n",
        "def set_current_state(v, p_prev, u):\n",
        "    global CURRENT_V, CURRENT_P_PREV, CURRENT_U\n",
        "    CURRENT_V      = v\n",
        "    CURRENT_P_PREV = p_prev\n",
        "    CURRENT_U      = u\n",
        "\n",
        "def calculate_utility(agent_name, my_action, opponent_action):\n",
        "    \"\"\"\n",
        "    Utility for a single turn based on Kyle model:\n",
        "    - agent 'insider' action = β, opponent = λ\n",
        "    - agent 'market_maker' action = λ, opponent = β\n",
        "\n",
        "    Uses CURRENT_V, CURRENT_P_PREV, CURRENT_U set before this call.\n",
        "    \"\"\"\n",
        "    if CURRENT_V is None:\n",
        "        raise RuntimeError(\"State not set. Call set_current_state(...) before calculate_utility().\")\n",
        "\n",
        "    v      = CURRENT_V\n",
        "    p_prev = CURRENT_P_PREV\n",
        "    u      = CURRENT_U\n",
        "\n",
        "    if agent_name == 'insider':\n",
        "        beta = my_action\n",
        "        lam  = opponent_action\n",
        "        insider_profit, mm_profit, _ = kyle_one_period_payoffs(beta, lam, v, p_prev, u)\n",
        "        return insider_profit\n",
        "    else:  # market_maker\n",
        "        beta = opponent_action\n",
        "        lam  = my_action\n",
        "        insider_profit, mm_profit, _ = kyle_one_period_payoffs(beta, lam, v, p_prev, u)\n",
        "        return mm_profit\n"
