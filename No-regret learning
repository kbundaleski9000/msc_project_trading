      "cell_type": "code",
      "source": [
        "# 3. Main Training Loop + snapshots for plotting\n",
        "# ============================================================\n",
        "def train_regret_matching(env:pettingzoo.AECEnv,\n",
        "                          num_episodes: int,\n",
        "                          snapshot_points=None):\n",
        "    \"\"\"\n",
        "    Trains two agents in the Kyle model environment using per-state Regret Matching.\n",
        "\n",
        "    - Actions: β from INSIDER_ACTIONS, λ from MM_ACTIONS\n",
        "    - Utility: per-period payoff (profit/loss), summed over time.\n",
        "    - No-regret: average regret per timestep -> 0.\n",
        "    \"\"\"\n",
        "    if snapshot_points is None:\n",
        "        snapshot_points = [10_000, 20_000, 30_000, 40_000, 50_000]\n",
        "\n",
        "    agents = env.possible_agents  # ['insider', 'market_maker']\n",
        "    action_spaces = {\n",
        "        'insider': INSIDER_ACTIONS,\n",
        "        'market_maker': MM_ACTIONS\n",
        "    }\n",
        "    num_actions = {name: len(spaces) for name, spaces in action_spaces.items()}\n",
        "\n",
        "    # regrets[agent][period_k][action_idx]\n",
        "    regret_sum = {\n",
        "        agent: np.zeros((NUM_PERIODS, num_actions[agent])) for agent in agents\n",
        "    }\n",
        "    # strategy_sum for average strategy\n",
        "    strategy_sum = {\n",
        "        agent: np.zeros((NUM_PERIODS, num_actions[agent])) for agent in agents\n",
        "    }\n",
        "    # empirical joint action distribution for CCE\n",
        "    empirical_dist = np.zeros((NUM_PERIODS,\n",
        "                               num_actions['insider'],\n",
        "                               num_actions['market_maker']))\n",
        "\n",
        "    # For regret diagnostics\n",
        "    regret_history = {agent: [] for agent in agents}\n",
        "\n",
        "    # For plotting: snapshot of expected actions per period\n",
        "    snapshots_insider = {}  # ep -> β_hat_t path (NUM_PERIODS,)\n",
        "    snapshots_mm      = {}  # ep -> λ_hat_t path (NUM_PERIODS,)\n",
        "\n",
        "    print(f\"Starting training for {num_episodes} episodes...\")\n",
        "\n",
        "    for episode in range(num_episodes):\n",
        "        ep_num = episode + 1\n",
        "        if ep_num % 1000 == 0:\n",
        "            print(f\"  Episode {ep_num}/{num_episodes}\")\n",
        "\n",
        "        # Fresh value and initial price\n",
        "        v = np.random.normal(loc=P0, scale=SIGMA_V)\n",
        "        p_prev = P0\n",
        "\n",
        "        # Noise sequence\n",
        "        u_seq = np.random.normal(loc=0.0, scale=SIGMA_U, size=NUM_PERIODS)\n",
        "\n",
        "        # --- Run a single episode ---\n",
        "        for k in range(NUM_PERIODS):\n",
        "            u_k = u_seq[k]\n",
        "\n",
        "            # Set state for this period (used inside calculate_utility)\n",
        "            set_current_state(v, p_prev, u_k)\n",
        "\n",
        "            # Current strategies for period k\n",
        "            strategies = {\n",
        "                agent: get_strategy(regret_sum[agent][k]) for agent in agents\n",
        "            }\n",
        "\n",
        "            # Actions drawn from mixed strategies\n",
        "            insider_action = sample_action(strategies['insider'], action_spaces['insider'])\n",
        "            mm_action      = sample_action(strategies['market_maker'], action_spaces['market_maker'])\n",
        "\n",
        "            # Update empirical distribution\n",
        "            insider_action_idx = np.where(action_spaces['insider'] == insider_action)[0][0]\n",
        "            mm_action_idx      = np.where(action_spaces['market_maker'] == mm_action)[0][0]\n",
        "            empirical_dist[k, insider_action_idx, mm_action_idx] += 1\n",
        "\n",
        "            # Kyle dynamics for this period (to evolve price)\n",
        "            beta = insider_action\n",
        "            lam  = mm_action\n",
        "            insider_pi, mm_pi, p_next = kyle_one_period_payoffs(beta, lam, v, p_prev, u_k)\n",
        "\n",
        "            # Regret updates\n",
        "            for agent in agents:\n",
        "                my_action = insider_action if agent == 'insider' else mm_action\n",
        "                opp_action = mm_action if agent == 'insider' else insider_action\n",
        "\n",
        "                actual_utility = calculate_utility(agent, my_action, opp_action)\n",
        "\n",
        "                for i, possible_action in enumerate(action_spaces[agent]):\n",
        "                    counterfactual_utility = calculate_utility(agent, possible_action, opp_action)\n",
        "                    regret = counterfactual_utility - actual_utility\n",
        "                    regret_sum[agent][k, i] += regret\n",
        "\n",
        "            # Strategy sum accumulation (for average strategy)\n",
        "            for agent in agents:\n",
        "                strategy_sum[agent][k] += strategies[agent]\n",
        "\n",
        "            # evolve price\n",
        "            p_prev = p_next\n",
        "\n",
        "        # --- regret_at_T / T diagnostics ---\n",
        "        T_so_far = ep_num\n",
        "        for agent in agents:\n",
        "            period_regrets = np.max(regret_sum[agent], axis=1)  # (NUM_PERIODS,)\n",
        "            avg_regret_per_timestep = np.mean(period_regrets) / T_so_far\n",
        "            regret_history[agent].append(avg_regret_per_timestep)\n",
        "\n",
        "        # --- snapshots for plotting learned actions vs equilibrium ---\n",
        "        if ep_num in snapshot_points:\n",
        "            print(f\"Taking snapshot at episode {ep_num}...\")\n",
        "            snapshots_insider[ep_num] = expected_action_path(\n",
        "                strategy_sum[\"insider\"], INSIDER_ACTIONS, ep_num\n",
        "            )\n",
        "            snapshots_mm[ep_num] = expected_action_path(\n",
        "                strategy_sum[\"market_maker\"], MM_ACTIONS, ep_num\n",
        "            )\n",
        "\n",
        "    print(\"Training finished.\")\n",
        "\n",
        "    # Final CCE & average strategies\n",
        "    total_plays_per_period = np.sum(empirical_dist, axis=(1, 2), keepdims=True)\n",
        "    cce_distribution = empirical_dist / np.maximum(total_plays_per_period, 1.0)\n",
        "\n",
        "    avg_strategies = {\n",
        "        agent: strategy_sum[agent] / np.sum(strategy_sum[agent], axis=1, keepdims=True)\n",
        "        for agent in agents\n",
        "    }\n",
        "\n",
        "    return cce_distribution, avg_strategies, regret_history, snapshots_insider, snapshots_mm"
      ],
