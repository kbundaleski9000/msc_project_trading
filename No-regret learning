        "def plot_action_convergence(snapshots_insider, snapshots_mm):\n",
        "    \"\"\"\n",
        "    Produce 10 plots total:\n",
        "      - 5 for insider: learned x_t vs equilibrium x_t*\n",
        "      - 5 for MM: learned p_t vs equilibrium p_t*\n",
        "    \"\"\"\n",
        "\n",
        "    # Use same random v and u_t for both EQ and learned paths\n",
        "    v = np.random.normal(loc=P0, scale=SIGMA_V)\n",
        "    u_seq = np.random.normal(loc=0.0, scale=SIGMA_U, size=NUM_PERIODS)\n",
        "\n",
        "    for ep in sorted(snapshots_insider.keys()):\n",
        "        beta_hat  = snapshots_insider[ep]     # (NUM_PERIODS,)\n",
        "        lambda_hat = snapshots_mm[ep]         # (NUM_PERIODS,)\n",
        "\n",
        "        # ---------------------------------------------\n",
        "        # Compute learned x_t and p_t paths\n",
        "        # ---------------------------------------------\n",
        "        p_rl = np.zeros(NUM_PERIODS + 1)\n",
        "        p_rl[0] = P0\n",
        "        x_rl = np.zeros(NUM_PERIODS)\n",
        "        y_rl = np.zeros(NUM_PERIODS)\n",
        "\n",
        "        for t in range(NUM_PERIODS):\n",
        "            x_rl[t] = beta_hat[t] * (v - p_rl[t-1])              # insider action\n",
        "            y_rl[t] = x_rl[t] + u_seq[t]                       # OF\n",
        "            p_rl[t] = p_rl[t-1] + lambda_hat[t] * y_rl[t]      # MM price\n",
        "\n",
        "        # ---------------------------------------------\n",
        "        # Compute equilibrium x_t* and p_t* paths\n",
        "        # ---------------------------------------------\n",
        "        p_eq = np.zeros(NUM_PERIODS + 1)\n",
        "        p_eq[0] = P0\n",
        "        x_eq = np.zeros(NUM_PERIODS)\n",
        "        y_eq = np.zeros(NUM_PERIODS)\n",
        "\n",
        "        for t in range(NUM_PERIODS):\n",
        "            x_eq[t] = BETA_EQ[t] * (v - p_eq[t-1])\n",
        "            y_eq[t] = x_eq[t] + u_seq[t]\n",
        "            p_eq[t] = p_eq[t-1] + LAMBDA_EQ[t] * y_eq[t]\n",
        "\n",
        "        periods = np.arange(1, NUM_PERIODS + 1)\n",
        "        periods0 = np.arange(0, NUM_PERIODS + 1)\n",
        "\n",
        "        # ---------------------------------------------\n",
        "        # Plot insider x_t\n",
        "        # ---------------------------------------------\n",
        "        plt.figure(figsize=(10,4))\n",
        "        plt.plot(periods, x_eq, \"k--\", label=\"Equilibrium $x_t^*$\")\n",
        "        plt.plot(periods, x_rl, \"o-\", label=fr\"Learned $x_t$ at {ep} episodes\")\n",
        "        plt.xlabel(\"t\")\n",
        "        plt.ylabel(\"$x_t$ (insider trading order)\")\n",
        "        plt.title(f\"Insider actions vs equilibrium (episode {ep})\")\n",
        "        plt.grid(alpha=0.3)\n",
        "        plt.legend()\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "\n",
        "        # ---------------------------------------------\n",
        "        # Plot MM p_t\n",
        "        # ---------------------------------------------\n",
        "        plt.figure(figsize=(10,4))\n",
        "        plt.plot(periods0, p_eq, \"k--\", label=\"Equilibrium $p_t^*$\")\n",
        "        plt.plot(periods0, p_rl, \"o-\", label=fr\"Learned $p_t$ at {ep} episodes\")\n",
