        "# 2. Regret Matching Helpers\n",
        "# ============================================================\n",
        "def get_strategy(regret_sum):\n",
        "    \"\"\"\n",
        "    regret_sum: vector of cumulative regrets for each action.\n",
        "    Strategy is proportional to positive regrets, uniform if all <= 0.\n",
        "    \"\"\"\n",
        "    positive_regrets = np.maximum(0.0, regret_sum)\n",
        "    normalizing_sum = np.sum(positive_regrets)\n",
        "\n",
        "    if normalizing_sum > 0:\n",
        "        return positive_regrets / normalizing_sum\n",
        "    else:\n",
        "        return np.ones(len(regret_sum)) / len(regret_sum)\n",
        "\n",
        "def sample_action(strategy, action_set):\n",
        "    \"\"\"Samples an action value from a strategy distribution.\"\"\"\n",
        "    action_index = np.random.choice(len(action_set), p=strategy)\n",
        "    return action_set[action_index]\n",
        "\n",
        "def expected_action_path(strategy_sum_agent, action_set, num_episodes_so_far):\n",
        "    \"\"\"\n",
        "    Given strategy_sum_agent: (NUM_PERIODS, num_actions),\n",
        "    compute E[action | period k] under the average strategy up to now.\n",
        "    \"\"\"\n",
        "    avg_strat = strategy_sum_agent / max(num_episodes_so_far, 1)\n",
        "    # (NUM_PERIODS, num_actions) @ (num_actions,) -> (NUM_PERIODS,)\n",
        "    return avg_strat @ action_set\n"
      ],
