        "def solve_kyle_equilibrium(T: int, sigma2_v: float, sigma2_u: float):\n",
        "    \"\"\"\n",
        "    Multi-period Kyle equilibrium via two-pass algorithm.\n",
        "    Returns dict with keys: 'Sigma', 'Lambda', 'Beta', 'Alpha', 'h'.\n",
        "    \"\"\"\n",
        "    sigma_u = math.sqrt(sigma2_u)\n",
        "    h = np.zeros(T)\n",
        "    h[-1] = 0.5  # terminal boundary condition\n",
        "\n",
        "    # Backward pass for h_n\n",
        "    for n in range(T - 2, -1, -1):\n",
        "        h_next = h[n + 1]\n",
        "        theta_next = math.sqrt(h_next / (1.0 - h_next))\n",
        "\n",
        "        def f(hn):\n",
        "            if hn <= 0.5 or hn >= 1.0:\n",
        "                return 1e6\n",
        "            return theta_next - (2.0 * hn - 1.0) / (hn * math.sqrt(1.0 - hn))\n",
        "\n",
        "        a, b = 0.5000001, 0.999999\n",
        "        fa, fb = f(a), f(b)\n",
        "        if fa * fb > 0:\n",
        "            b = 0.95\n",
        "            fa, fb = f(a), f(b)\n",
        "\n",
        "        for _ in range(200):\n",
        "            m = 0.5 * (a + b)\n",
        "            fm = f(m)\n",
        "            if abs(fm) < 1e-12 or (b - a) < 1e-12:\n",
        "                h[n] = m\n",
        "                break\n",
        "            if fa * fm < 0:\n",
        "                b, fb = m, fm\n",
        "            else:\n",
        "                a, fa = m, fm\n",
        "        else:\n",
        "            h[n] = 0.75  # fallback\n",
        "\n",
        "    Sigma  = np.zeros(T + 1)\n",
        "    Lambda = np.zeros(T)\n",
        "    Beta   = np.zeros(T)\n",
        "    Alpha  = np.zeros(T)\n",
        "    Sigma[0] = sigma2_v\n",
        "    eps = 1e-12\n",
        "\n",
        "    for t in range(T):\n",
        "        Sigma[t + 1] = h[t] * Sigma[t]\n",
        "        Lambda[t] = math.sqrt(max(1.0 - h[t], 0.0) * Sigma[t + 1]) / sigma_u\n",
        "        Beta[t]   = math.sqrt(max(1.0 - h[t], 0.0)) * sigma_u / math.sqrt(Sigma[t + 1] + eps)\n",
        "        Alpha[t]  = (sigma_u / (2.0 * math.sqrt(Sigma[t] + eps))) * math.sqrt(h[t] / max(1.0 - h[t], eps))\n",
        "\n",
        "    return {\n",
        "        \"Sigma\": Sigma,\n",
        "        \"Lambda\": Lambda,\n",
        "        \"Beta\": Beta,\n",
        "        \"Alpha\": Alpha,\n",
        "        \"h\": h\n",
